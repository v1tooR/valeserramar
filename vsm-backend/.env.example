# Copie para .env e informe os dados do seu PostgreSQL.
DATABASE_URL=postgresql://USUARIO_DO_BANCO:SENHA_DO_BANCO@127.0.0.1:5432/novo_app

# Certificado CA em Base64, quando fornecido pelo provedor PostgreSQL.
DATABASE_CA_BASE64=

# Configuração para rodar a API localmente.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
MEDIA_DIR=./media
TRUST_PROXY=0

# Origens do Expo Web local, separadas por vírgula.
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# No Docker Compose, use o mesmo domínio em API_DOMAIN e na PUBLIC_URL HTTPS.
API_DOMAIN=api.example.com

# Opcional para a versão com painel. Gere o hash com npm run admin:hash.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
